    "@tiptap/extension-link": "2.26.1",
    "@tiptap/extension-placeholder": "2.26.1",
    "@tiptap/react": "2.26.1",
    "@tiptap/starter-kit": "2.26.1",
    "@xyflow/react": "12.11.3",
    "axios": "1.11.0",
    "dompurify": "3.2.6",
    "html-to-image": "1.11.13",
    "msw": "2.11.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
