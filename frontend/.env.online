# 온라인 실습(StackBlitz)용 설정. `pnpm run dev:online`이 `vite --mode online`으로 이 파일을 읽는다.
# StackBlitz에는 Spring Boot 백엔드가 없으므로 처음부터 더미 데이터(MSW)로 시작한다.
VITE_API_BASE_URL=/api/v1
VITE_HTTP_CLIENT=axios
VITE_DATA_SOURCE=mock
VITE_MOCK_SCENARIO=success
VITE_DEVELOPMENT_MEMBER_ID=1
VITE_ENABLE_DEVELOPMENT_MENU=true
VITE_SITE_URL=
