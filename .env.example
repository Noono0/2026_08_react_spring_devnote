MYSQL_DATABASE=devnote
MYSQL_USERNAME=devnote
MYSQL_PASSWORD=devnote
MYSQL_ROOT_PASSWORD=root-devnote
MYSQL_PORT=3306
BACKEND_PORT=8080
FRONTEND_PORT=3000
VITE_API_BASE_URL=/api/v1
VITE_HTTP_CLIENT=axios
VITE_DATA_SOURCE=backend
VITE_MOCK_SCENARIO=success
VITE_DEVELOPMENT_MEMBER_ID=1
VITE_ENABLE_DEVELOPMENT_MENU=true
VITE_SITE_URL=

# 로컬 연습 DB 구조 자동 보정. 운영 환경에서는 validate 권장
JPA_DDL_AUTO=update

# 초기 슈퍼관리자(admin / admin1234)의 PBKDF2 해시입니다. 외부 배포 전에 반드시 교체하세요.
INITIAL_SUPER_ADMIN_PASSWORD_HASH=600000:2519u3hcpq5hx8SaSCvL9A==:LQjLKoKo4WuJr2WDDpE3FAkNQCMtoPmH8e9U77Fa2Gc=
AUTH_SESSION_TIMEOUT=30m
AUTH_REMEMBER_ME_DURATION=30d
# 로그인 실패 제한: 같은 IP·아이디로 FAILURE_WINDOW 안에 MAX_FAILURES번 틀리면 LOCK_DURATION 동안 잠금
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_FAILURE_WINDOW=15m
AUTH_LOGIN_LOCK_DURATION=15m
SESSION_COOKIE_SECURE=false

# 크롤러 브라우저 실행 위치: local(이 컴퓨터에서 Chromium 실행) / remote(CRAWLER_REMOTE_BROWSER_URL의 Chrome에 연결)
# 운영 서버(compose.app.yml)는 기본 remote. 설정 방법은 docs/crawler.md "브라우저 실행 위치"
CRAWLER_BROWSER_MODE=local
CRAWLER_REMOTE_BROWSER_URL=
