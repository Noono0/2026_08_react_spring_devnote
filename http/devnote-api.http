@backendUrl = http://localhost:8080
@memberId = 1

### 문서 목록 조회
GET {{backendUrl}}/api/v1/documents?searchKeyword=React&searchType=TITLE_CONTENT&pageNumber=0&pageSize=10&sortProperty=UPDATED_AT&sortDirection=DESC
X-Member-Id: {{memberId}}
X-Request-Id: manual-list-request-001

### 문서 상세 조회
GET {{backendUrl}}/api/v1/documents/1
X-Member-Id: {{memberId}}

### 문서 생성
POST {{backendUrl}}/api/v1/documents
Content-Type: application/json
X-Member-Id: {{memberId}}

{
  "documentTitle": "HTTP 파일로 만든 문서",
  "thumbnailFileId": null,
  "contentJson": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "문서 내용" }]
      }
    ]
  },
  "contentHtml": "<p>문서 내용</p>",
  "contentText": "문서 내용",
  "documentStatus": "DRAFT"
}

### 문서 수정 - versionNumber를 상세 조회 결과와 맞추세요.
PUT {{backendUrl}}/api/v1/documents/1
Content-Type: application/json
X-Member-Id: {{memberId}}

{
  "documentTitle": "수정한 React 상태 관리 연습",
  "thumbnailFileId": null,
  "contentJson": { "type": "doc", "content": [] },
  "contentHtml": "<p>수정한 내용</p>",
  "contentText": "수정한 내용",
  "documentStatus": "PUBLISHED",
  "versionNumber": 1,
  "changeSummary": "HTTP 파일 수정 테스트"
}

### 변경 이력 조회
GET {{backendUrl}}/api/v1/documents/1/histories
X-Member-Id: {{memberId}}

### 파일 업로드
POST {{backendUrl}}/api/v1/files/attachments
X-Member-Id: {{memberId}}
Content-Type: multipart/form-data; boundary=DevNoteBoundary

--DevNoteBoundary
Content-Disposition: form-data; name="attachmentFile"; filename="example.txt"
Content-Type: text/plain

파일 업로드 테스트
--DevNoteBoundary--
